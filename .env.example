# Eduson Kids — образец окружения. Скопировать в .env (рядом с этим файлом,
# platform/.env) и заполнить. config/settings/base.py читает .env отсюда.
#
# .env в git не попадает и не должен: здесь пароль БД, SMTP и токены.
#
# ВАЖНО для числовых переменных (SMTP_PORT, TELEGRAM_GENERAL_CHAT_ID,
# NOTIFICATIONS_HISTORY_LIMIT): пустое значение «KEY=» роняет запуск
# (int('')). Либо число, либо строку не писать вовсе — тогда действует default.

# --- База данных ------------------------------------------------------------

# Рабочая БД форка. Тесты сюда НЕ ходят (см. TEST_DB_NAME).
DATABASE_URL=postgresql://<user>:<pass>@localhost:5432/eduson
# Отдельная БД для pytest; config/settings/test.py отказывается работать с
# чем-либо, кроме *_test. Создать из миграций: journal_django/scripts/recreate_test_db.sh
TEST_DB_NAME=eduson_test

# --- Безопасность -----------------------------------------------------------

# 128 hex-символов: python -c "import secrets; print(secrets.token_hex(64))"
# SECRET_KEY обязателен в проде; ADMIN_COOKIE_SECRET — запасной источник для dev.
SECRET_KEY=
ADMIN_COOKIE_SECRET=

# Домены, с которых принимаются запросы. В production.py пусто = не пустит никого.
ALLOWED_HOSTS=
# Origin'ы для CSRF (со схемой, https://<домен>). Нужны в проде.
CSRF_TRUSTED_ORIGINS_LIST=
# Белый список кросс-ориджин. Пусто = кросс-ориджин запрещён (так и нужно,
# пока SPA и API на одном домене). Локально CORS задан в development.py.
CORS_ORIGINS=

# --- Celery и кэш -----------------------------------------------------------

# Пусто → синхронный режим, кэш в памяти, задачи по расписанию не идут.
# Если Redis общий с KOTOKOD — брать свободную базу (не /0), например /2.
REDIS_URL=

# --- Почта: одноразовые коды входа и email-напоминания ----------------------

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Публичный адрес журнала (https://<домен>) — ссылка на кабинет преподавателя в
# письмах «Урок не записан». Пусто → письма уходят без ссылки.
PUBLIC_URL=

# --- Telegram-уведомления ---------------------------------------------------

# Токен бота уведомлений.
TELEGRAM_BOT_TOKEN=
# Общий чат сотрудников (-100…). Не задано → дубли в общий чат не идут.
# TELEGRAM_GENERAL_CHAT_ID=
# Общий секрет журнал ↔ бот для /api/integrations/telegram.
BOT_SERVICE_TOKEN=
# Сколько ЗАВЕРШЁННЫХ записей очереди уведомлений хранить.
NOTIFICATIONS_HISTORY_LIMIT=200

# --- Гард оплат ------------------------------------------------------------

# true — запрет KOTOKOD: ученика без оплаченных уроков (баланс <= 0) нельзя
# отметить на уроке и в доп.уроке, а «Продлён» менеджеру доступен только при
# балансе > 0. Eduson оплаты в платформе не ведёт — поэтому по умолчанию false
# (не задано = false). Расчёт баланса от флага не зависит, снимается только запрет.
PAYMENT_BALANCE_GUARD=false

# --- Wiki (apps/knowledge): хранилище файлов --------------------------------

# Каталог загруженных файлов вне репозитория. Не задано → journal_django/media.
KNOWLEDGE_MEDIA_ROOT=
# Префикс internal-локации nginx для X-Accel-Redirect. Пусто → Django отдаёт
# файлы сам (локальный runserver без nginx).
KNOWLEDGE_X_ACCEL_PREFIX=

# --- Обновление из прода старой системы (scripts/refresh_from_prod.sh) ------

# Прод старой системы Eduson — источник правды на время переработки платформы.
# Скрипт снимает с него копию SQLite ТОЛЬКО чтением и целиком пересобирает
# рабочую БД (DATABASE_URL, имя обязано начинаться с eduson). Подробно —
# docs/eduson/refresh-from-prod.md. Адрес сервера и почты в репозиторий не пишутся:
# заполнять только в своём .env.
#
# SSH до сервера старой системы, user@host (вход по ключу, BatchMode). Пусто → скрипт
# отказывается работать.
EDUSON_PROD_SSH=
# Docker-контейнер старой системы. Пусто → aiokk-web.
EDUSON_PROD_CONTAINER=
# Путь к SQLite внутри контейнера. Пусто → /app/server/data/okk.db.
EDUSON_PROD_DB=
# Каталог снимков (ПДн!) — только вне репозитория; относительный путь — от platform/.
# Пусто → ../data/prod-snapshots. Там же refresh.log.
EDUSON_SNAPSHOT_DIR=
# Сколько последних снимков хранить. Пусто → 7.
EDUSON_SNAPSHOT_KEEP=
# Почты учёток-admin Eduson, которые станут superadmin (через запятую) →
# import_eduson --superadmin. Необязательно; без них сверка предупредит.
EDUSON_SUPERADMINS=
# ID публичных Google-таблиц Eduson по курсам (часть URL между /d/ и /edit): перед
# импортом скрипт скачивает их вкладки «Июнь 2026» и «Июнь 2027» → import_eduson
# --sheets-dir (уроки до запуска старой системы для групп с «пройдено до учёта»).
# В таблицах ПДн учеников — ID в репозиторий НЕ кладутся, только в свой .env.
# Только символы [A-Za-z0-9_-]. Не задан хоть один или скачать не удалось — импорт
# идёт без таблиц, с предупреждением в refresh.log.
EDUSON_SHEET_SCRATCH=
EDUSON_SHEET_PYTHON=
EDUSON_SHEET_VIBE=
EDUSON_SHEET_GROUPS=
# Кнопка «Обновить данные с прода» в «Синхро» (refresh_from_prod.sh --soft): true — показать.
# Только локально, пока источник правды — старая система; на проде платформы не включать.
EDUSON_PROD_REFRESH_BUTTON=
# Путь к bash.exe Git Bash для кнопки. Пусто → C:\Program Files\Gitinash.exe, иначе bash из PATH
# (в Windows «bash» из PATH бывает WSL — он скрипт не запустит).
EDUSON_REFRESH_BASH=
