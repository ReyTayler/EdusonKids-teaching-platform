# Токен бота от @BotFather. Тот же, что TELEGRAM_BOT_TOKEN в .env журнала:
# рассылку ведёт журнал, а бот тем же токеном принимает сообщения.
BOT_TOKEN=

# Таймзона
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Интеграция с журналом (Django) ────────────────────────────────────────
# Локально с runserver — http://127.0.0.1:8100
# В Docker бот ходит прямо в контейнер журнала, минуя nginx: http://app:8000
JOURNAL_API_URL=http://127.0.0.1:8100

# Домен из ALLOWED_HOSTS журнала того окружения, где работает бот.
# Нужен, потому что запрос идёт мимо nginx и без подмены Host Django ответит 400.
# Локально оставить пустым.
JOURNAL_HOST=

# Общий секрет для заголовка X-Bot-Token — тот же, что BOT_SERVICE_TOKEN
# на стороне журнала. Наружу /api/integrations/ закрыт в nginx.
BOT_SERVICE_TOKEN=
