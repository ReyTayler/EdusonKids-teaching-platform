# Образец настроек staging-контейнеров. Скопировать в .env.staging рядом и
# заполнить: cp .env.staging.example .env.staging
# .env.staging — секрет, в git не коммитится (закрыт .gitignore).

# --- База (контейнер db). Пароль — любой длинный случайный. ---
# Один и тот же пароль в двух местах: POSTGRES_PASSWORD создаёт пользователя
# при первом запуске, DATABASE_URL — по нему подключается приложение.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://eduson:change-me@db:5432/eduson_staging

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=
ADMIN_COOKIE_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS_LIST=https://localhost:8443,https://127.0.0.1:8443
CORS_ORIGINS=
PUBLIC_URL=https://127.0.0.1:8443

# --- Файлы базы знаний (том media; nginx отдаёт их через /internal-media/) ---
KNOWLEDGE_MEDIA_ROOT=/media
KNOWLEDGE_X_ACCEL_PREFIX=/internal-media/

# --- Без Redis: синхронные задачи и кеш в памяти процесса ---
REDIS_URL=

# --- Уведомления НАМЕРЕННО выключены: staging не пишет людям ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GENERAL_CHAT_ID=0
BOT_SERVICE_TOKEN=

# --- Как в рабочей локальной копии ---
PAYMENT_BALANCE_GUARD=false
EDUSON_PROD_REFRESH_BUTTON=false
