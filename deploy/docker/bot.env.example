# Бот Eduson в Docker (локальный staging, профиль bot). Скопировать в bot.env.
# BOT_TOKEN = TELEGRAM_BOT_TOKEN из .env.staging, BOT_SERVICE_TOKEN — тот же, что там.
BOT_TOKEN=
BOT_SERVICE_TOKEN=
JOURNAL_API_URL=http://app:8000
# Домен из ALLOWED_HOSTS журнала (локально — 127.0.0.1).
JOURNAL_HOST=127.0.0.1
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
